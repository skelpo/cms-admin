{
  "name": "skelpo-cms-admin",
  "version": "0.2.0",
  "private": true,
  "description": "Skelpo CMS Admin \u2014 native cross-platform admin client (Perry/ui) for a Skelpo CMS backend.",
  "license": "UNLICENSED",
  "main": "client/main.ts",
  "scripts": {
    "check": "perry check client/main.ts",
    "build": "perry compile client/main.ts -o build/client",
    "dev": "perry run client/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@skelpo/markdown-editor": "file:../skelpo-markdown-editor"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "@skelpo/markdown-editor"
      ]
    }
  }
}
